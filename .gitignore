# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env. `*.local` above already covers .env.local, but plain .env was not
# ignored — added 2026-07-28 before it could hold anything.
.env
.env.*
!.env.example

# Per-run output from scripts/monitor-bills.js. Regenerated every run and uploaded as a
# CI artifact, never committed. Note bill-status-history.json IS tracked — not one of these.
monitoring-report.txt
monitoring-summary.html
monitoring-meta.json
bluesky-would-post.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Statehood-bill files derived at build time by scripts/generate-stats.js from tracked
# sources (src/data/statehood-cosponsors.json, src/data/statehood-bill-history.json).
# Not committed: every workflow regenerates them, and a regenerated tracked file would
# leave a dirty tree that blocks the discovery workflow's rebase-and-retry. The roster,
# public/api/members-<congress>.json, is fetched rather than derived, so it IS tracked.
public/api/statehood-cosponsors.json
public/api/statehood-bill-history.json
