# Copy to `.env` (gitignored) and fill in. Vite only exposes VITE_-prefixed vars.

# PostHog project API key, from PostHog → Settings → Project → Project API Key.
# This is the PUBLISHABLE key (starts with `phc_`). It is inlined into the built
# HTML and visible to every visitor by design — it can only write events, not read
# data. Do NOT put a PostHog *Personal* API key here; that one reads your data and
# is a real secret.
#
# Leave unset to disable tracking entirely — the site builds and runs normally.
VITE_POSTHOG_KEY=
